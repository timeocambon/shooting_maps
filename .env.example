# Public Supabase configuration. These values are safe for the browser when RLS
# policies are enabled; never put the service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Fond raster OpenStreetMap intégré pour le développement. Une URL de style
# MapLibre fournie par un prestataire peut le remplacer en production.
NEXT_PUBLIC_MAP_STYLE_URL=osm-raster

# Server-only transactional email configuration. Leave blank locally: the
# confirmation page will expose a development-only test link.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Spotride Toulouse

# Suivi d'erreurs (Sentry). Laisser vide en local : le SDK reste inactif tant
# que NEXT_PUBLIC_SENTRY_DSN n'est pas renseigné. SENTRY_AUTH_TOKEN n'est
# utilisé qu'au build (envoi des source maps) et ne doit jamais être exposé au
# navigateur ni committé.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Mesure d'audience (Plausible). Laisser vide en local : aucun script n'est
# chargé tant que cette variable est absente. Doit correspondre au domaine
# ajouté dans Plausible (ex. spotride-toulouse.fr).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
